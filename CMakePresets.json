{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 22, "patch": 0 },
  "configurePresets": [
    {
      "name": "arm",
      "displayName": "STM32C5 firmware (arm-none-eabi-gcc)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/arm",
      "toolchainFile": "${sourceDir}/cmake/toolchain-arm-none-eabi.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "MinSizeRel"
      }
    },
    {
      "name": "arm-release",
      "displayName": "STM32C5 firmware (Release, -Werror)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/arm-release",
      "toolchainFile": "${sourceDir}/cmake/toolchain-arm-none-eabi.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "WERROR": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "arm",
      "configurePreset": "arm"
    },
    {
      "name": "arm-release",
      "configurePreset": "arm-release"
    }
  ]
}
